# ══════════════════════════════════════════════════════════════════════
# Negarit AI — Environment Configuration
# ══════════════════════════════════════════════════════════════════════
# Copy to `.env` and fill in real values.  NEVER commit a populated .env.
#   cp .env.example .env
#
# Every variable below is referenced by code via typed settings.
# Nothing in the codebase may read a secret from a hard-coded literal.
# ══════════════════════════════════════════════════════════════════════


# ── Application ───────────────────────────────────────────────────────
APP_NAME="Negarit AI"
# development | staging | production
APP_ENV=development
# Public origin of the web frontend (used for CORS + absolute links)
FRONTEND_URL=http://localhost:3000


# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Matches the `postgres` service in docker-compose.yml.
POSTGRES_USER=negarit
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=negarit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Assembled from the parts above by app/config/settings.py
DATABASE_URL=postgresql://negarit:change_me_in_production@localhost:5432/negarit


# ── Security / JWT ────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# There is deliberately NO insecure default — the app refuses to boot
# without this in staging/production (see settings.py).
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2/bcrypt password hashing cost
PASSWORD_HASH_ITERATIONS=12


# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000


# ── Rate limiting (§21) ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Tighter bucket applied to the expensive analysis endpoints.
ANALYSIS_RATE_LIMIT_REQUESTS=10
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60


# ── File uploads (§22) ────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=./storage/uploads


# ── Logging (§24) ─────────────────────────────────────────────────────
# debug | info | warning | error
LOG_LEVEL=info
# true → newline-delimited JSON logs (structured, §24)
LOG_JSON_FORMAT=false


# ── AI Engine ─────────────────────────────────────────────────────────
# Run the deterministic rule/feature engines with no network calls.
# Recommended for hackathon demos so the demo never depends on a 3rd party.
AI_OFFLINE_MODE=true
# Directory holding serialised model artefacts (optional).
AI_MODEL_DIR=./ai/models
# Emit an explicit banner on mocked/simulated signals so the UI can
# label them honestly (§30 — never present mocks as real inference).
AI_LABEL_SIMULATED_SIGNALS=true


# ── Risk engine (§11) ─────────────────────────────────────────────────
# Thresholds are configuration, never business rules in code.
#   score <  SAFE_MAX              → SAFE
#   score <  SUSPICIOUS_MAX        → SUSPICIOUS
#   otherwise                     → DANGEROUS
RISK_SAFE_MAX=29
RISK_SUSPICIOUS_MAX=69
# Relative weight of each signal family in the aggregate 0–100 score.
RISK_WEIGHT_PHISHING=0.30
RISK_WEIGHT_URL=0.25
RISK_WEIGHT_SENDER=0.15
RISK_WEIGHT_THREAT_INTEL=0.20
RISK_WEIGHT_IMAGE=0.10
# A family counts as corroborating at or above this score. Agreement between
# independent families refines a verdict but can never manufacture one.
RISK_AGREEMENT_THRESHOLD=0.50
# How much corroboration moves the score, in 0..1.
RISK_CORROBORATION_STRENGTH=0.35
# Bounded uplift applied when any CRITICAL indicator fires, in 0..1.
RISK_CRITICAL_BONUS=0.02


# ── Threat intelligence (§8) ──────────────────────────────────────────
# All providers are optional. With no keys the system falls back to
# local lexical/reputation analysis and labels it accordingly.
THREAT_INTEL_ENABLED=false
THREAT_INTEL_TIMEOUT_SECONDS=8
VIRUSTOTAL_API_KEY=
IPINFO_API_TOKEN=
# Use a local WHOIS client instead of the network one.
THREAT_INTEL_OFFLINE_WHOIS=true


# ── OCR (§9) ──────────────────────────────────────────────────────────
OCR_ENGINE=tesseract
# Comma-separated language codes passed to the OCR engine.
OCR_LANGUAGES=eng
OCR_MIN_CONFIDENCE=40


# ── Optional LLM (explanation only — NOT a detection signal) ──────────
# Per §35 the security decision never depends on generated text. This is
# used solely to phrase explanations more naturally. Leave blank to
# disable; the built-in template generator is fully sufficient.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=30


# ── Legacy Express backend (being retired in favour of FastAPI) ───────
# Kept only so the current frontend keeps working during the migration.
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000